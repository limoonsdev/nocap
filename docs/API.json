    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Service health",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Supported captcha types",
        "operationId": "capabilities_v1_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Capability"
                  },
                  "type": "array",
                  "title": "Response Capabilities V1 Capabilities Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/solve": {
      "post": {
        "tags": [
          "solve"
        ],
        "summary": "Universal solver: 35+ types, single endpoint (JSON)",
        "description": "Send `type` (required) + image via `image_b64` or `image_url`\n(or `sitekey`+`url` for browser tokens, `data.challenge` for PoW).\nReturns the answer: `text`, `coords`, `selected_ids` or `token`.",
        "operationId": "solve_generic_v1_solve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SolveResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
