{
  "openapi": "3.1.0",
  "info": {
    "title": "NoCaptcha API",
    "description": "100% local captcha solver (humanized Playwright): 35+ types, speed metrics, auto-learn, 0 rate-limit.",
    "version": "0.1.0"
  },
