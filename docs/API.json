  "components": {
    "schemas": {
      "Body_solve_audio_v1_solve_audio_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_solve_audio_v1_solve_audio_post"
      },
      "Body_solve_file_v1_solve_file_post": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Captcha type, e.g. amazon-captcha, slider-captcha (see /v1/capabilities)"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Main image (captcha, slider background, ...)"
          },
          "file2": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "File2",
            "description": "Second image (slider piece)"
          },
          "instruction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction",
            "description": "Instruction for click-captcha / image grids"
          },
          "sitekey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sitekey"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "langs": {
            "type": "string",
            "title": "Langs",
            "default": "en"
          },
          "timeout": {
            "type": "integer",
            "title": "Timeout",
            "default": 90
          }
        },
        "type": "object",
        "required": [
          "type",
          "file"
        ],
        "title": "Body_solve_file_v1_solve_file_post"
      },
      "Body_solve_ocr_upload_v1_solve_ocr_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "preprocess": {
            "type": "boolean",
            "title": "Preprocess",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_solve_ocr_upload_v1_solve_ocr_upload_post"
      },
      "Capability": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "supported": {
            "type": "boolean",
            "title": "Supported"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "local": {
            "type": "boolean",
            "title": "Local",
            "default": true
          },
          "notes": {
            "type": "string",
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "type",
          "supported",
          "method"
        ],
        "title": "Capability"
      },
      "CaptchaType": {
        "type": "string",
        "enum": [
          "recaptcha-v2",
          "recaptcha-v3",
          "recaptcha-enterprise",
          "hcaptcha",
          "turnstile",
          "funcaptcha",
          "arkose",
          "geetest",
          "geetest-v4",
          "image-select",
          "image-captcha",
          "image-text",
          "normal-captcha",
          "text-captcha",
          "number-captcha",
          "russian-captcha",
          "chinese-captcha",
          "amazon-captcha",
          "vk-captcha",
          "atb-captcha",
          "math-captcha",
          "click-captcha",
          "audio",
          "audio-captcha",
          "slider-captcha",
          "rotate-captcha",
          "cutcaptcha",
          "capy-puzzle",
          "temu-captcha",
          "lemin-captcha",
          "binance-captcha",
          "tencent-captcha",
          "altcha",
          "friendly-captcha",
          "captchafox",
          "mtcaptcha",
          "prosopo-procaptcha",
          "datadome-captcha",
          "imperva-captcha"
        ],
        "title": "CaptchaType"
      },
      "ClickRequest": {
        "properties": {
          "image_b64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image B64"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "instruction": {
            "type": "string",
            "title": "Instruction",
            "description": "E.g. 'Click on all cats'"
          }
        },
        "type": "object",
        "required": [
          "instruction"
        ],
        "title": "ClickRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageSolveRequest": {
        "properties": {
          "instruction": {
            "type": "string",
            "title": "Instruction",
            "description": "E.g. 'Select all images with traffic lights'"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageTile"
            },
            "type": "array",
            "title": "Images"
          },
          "animated": {
            "type": "boolean",
            "title": "Animated",
            "description": "True for animated tiles (gif/webp/video)",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "instruction",
          "images"
        ],
        "title": "ImageSolveRequest"
      },
      "ImageTile": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "title": "Id"
          },
          "image_b64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image B64"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "ImageTile"
      },
      "MathRequest": {
        "properties": {
          "image_b64": {
            "anyOf": [
              {
                "type": "string"
              },
